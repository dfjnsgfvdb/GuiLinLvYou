# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8088
SERVER_WORKERS=1

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13006
MYSQL_USER=root
MYSQL_PASSWORD=1
MYSQL_DATABASE=chat_db
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:1@127.0.0.1:13006/chat_db

# MinIO
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=12345678

# Redis conversation memory
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB=0
REDIS_PASSWORD=liguan_dev_redis
REDIS_CHAT_MEMORY_ENABLED=true
REDIS_CHAT_MEMORY_TTL_SECONDS=604800
REDIS_CHAT_MEMORY_MAX_TURNS=12

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123

# OpenAI-compatible chat model
MODEL_TYPE=openai
MODEL_NAME=your-chat-model
MODEL_BASE_URL=https://your-model-provider.example/v1
MODEL_API_KEY=replace_with_your_api_key
MODEL_TEMPERATURE=0.2

# OpenAI-compatible embedding model
EMBEDDING_MODEL_NAME=your-embedding-model
EMBEDDING_BASE_URL=https://your-model-provider.example/v1
EMBEDDING_API_KEY=replace_with_your_api_key
EMBEDDING_BATCH_SIZE=32
EMBEDDING_ENABLE_HASH_FALLBACK=false
EMBEDDING_FALLBACK_DIM=1024

# Tourism extraction and retrieval
TOURISM_EXTRACTION_LLM_ENABLED=true
TOURISM_EXTRACTION_MODEL_NAME=your-chat-model
TOURISM_EXTRACTION_MAX_CHARS=6000
TOURISM_MIN_VECTOR_SCORE=0.45
TOURISM_MIN_BM25_SCORE=0.50
TOURISM_LLM_TIMEOUT_SECONDS=90
VECTOR_RECALL_TOP_K=30
BM25_RECALL_TOP_K=30
MYSQL_EVENT_RECALL_TOP_K=20
GRAPH_EXPAND_TOP_K=20
RERANK_TOP_K=12
FINAL_CONTEXT_TOP_K=6
RERANK_SCORE_THRESHOLD=0.35
RERANK_LLM_ENABLED=true
RERANK_LLM_MODEL_NAME=your-chat-model
RERANK_LLM_TIMEOUT_SECONDS=20
EVIDENCE_COMPRESS_MAX_CHARS=420

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
SHOW_THINKING_PROCESS=false
